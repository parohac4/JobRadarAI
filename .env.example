# === JobRadar AI ===
# Kopie: cp .env.example .env  |  Na produkci: viz docs/03-PRISTUPY-A-KONFIGURACE.md

APP_ENV=development
# Na produkci (APP_ENV=production) min. 32 znaků, jinak backend nenastartuje: openssl rand -hex 32
SECRET_KEY=change-me-to-long-random-string
DEMO_MODE=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900
# API_DOCS=true

# Přihlášení (HttpOnly cookie na produkci; pro testy/API klienta lze vypnout)
AUTH_USE_HTTPONLY_COOKIE=true
# ENFORCE_CLOUDFLARE=true

ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me

POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar_secret
POSTGRES_DB=jobradar
DATABASE_URL=postgresql+asyncpg://jobradar:jobradar_secret@db:5432/jobradar

# AI
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AUTO_EVALUATE_ON_IMPORT=false
AI_DAILY_MAX_CALLS=50

# Worker (IMAP + RSS)
WORKER_ENABLED=true
SYNC_INTERVAL_SECONDS=900

# Gmail IMAP – viz docs/07-ETAPA2-PLAN.md
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=JobRadar

# Notifikace
NOTIFY_ENABLED=false
NOTIFY_MIN_SCORE=70
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

VITE_API_BASE=/api/v1
VITE_BASE_PATH=

# PUBLIC_PATH=/nastenka
# DOMAIN=chcetejelena.cz
