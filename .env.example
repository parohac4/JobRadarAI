# === JobRadar AI ===
# Kopie: cp .env.example .env  |  Na produkci: viz docs/03-PRISTUPY-A-KONFIGURACE.md

APP_ENV=development
# Na produkci (APP_ENV=production) min. 32 znaků, jinak backend nenastartuje: openssl rand -hex 32
SECRET_KEY=change-me-to-long-random-string
DEMO_MODE=false
# Platnost přihlášení v minutách (výchozí 24 h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Ochrana přihlášení: max. neúspěšných pokusů za okno (sekundy) na e-mail i IP
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900
# Swagger /api/v1/docs – výchozí: zapnuto mimo produkci, v produkci vypnuto
# API_DOCS=true

# Přihlášení do webu (synchronizuje se s DB při startu backendu – jeden uživatel)
# Na produkci heslo min. 12 znaků
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me

# PostgreSQL (Docker)
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar_secret
POSTGRES_DB=jobradar
DATABASE_URL=postgresql+asyncpg://jobradar:jobradar_secret@db:5432/jobradar

# AI (volitelné – bez klíče = mock hodnocení)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# E-mail import (Etapa 3)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Frontend – lokální dev (kořen /)
VITE_API_BASE=/api/v1
VITE_BASE_PATH=

# Produkce na doméně (např. chcetejelena.cz/nastenka)
# PUBLIC_PATH=/nastenka
# DOMAIN=chcetejelena.cz
# Build frontendu na produkci řeší deploy/docker-compose.apache.yml
