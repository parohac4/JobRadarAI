# === JobRadar AI ===
APP_ENV=development
SECRET_KEY=change-me-to-long-random-string
DEMO_MODE=false

# První uživatel (vytvoří se při startu, pokud neexistuje)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me

# PostgreSQL
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar_secret
POSTGRES_DB=jobradar
DATABASE_URL=postgresql+asyncpg://jobradar:jobradar_secret@db:5432/jobradar

# AI (volitelné – bez klíče se použije mock hodnocení)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# E-mail import (volitelné, Etapa 1: parsování vloženého textu)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Frontend (build-time)
VITE_API_BASE=/api/v1

# Caddy
DOMAIN=localhost
